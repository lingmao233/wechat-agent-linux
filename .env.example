# Runtime
WECHAT_WINDOW_CLASS=mmui::MainWindow
WECHAT_EXE=C:\\Program Files\\Tencent\\Weixin\\Weixin.exe
WECHAT_GROUP_NAMES=
WECHAT_PRIVATE_REPLY_ENABLED=false
# 默认不主动发起私聊；开启后也只向新加入白名单的联系人发送一次欢迎语。
WECHAT_PRIVATE_PROACTIVE_ENABLED=false
# 只允许此逗号分隔名单内的联系人；名单为空时不监听、不回复任何私聊。
WECHAT_PRIVATE_CHAT_NAMES=
# 旧版单群配置；存在 WECHAT_GROUP_NAMES 时以新配置为准。
WECHAT_GROUP_NAME=
# 机器人名称：只匹配显式 @ 或消息开头的名称，不会匹配普通回答中的“AI”。
WECHAT_AI_ALIASES=AI,ai,机器人
# 任意位置关键词：命中其中一项才触发关键词回复。
WECHAT_KEYWORDS=问AI,小助手
WECHAT_SELF_NAME=
# AI 自己的名字，可逗号分隔多个；判定夸奖/辱骂在说谁时以它为准。留空则用微信昵称、人设名和称呼别名。
WECHAT_BOT_NAME=
# 逗号分隔的微信唯一 member_id/wxid；留空表示不限制成员，昵称不作为白名单键。
WECHAT_ALLOWED_MEMBERS=
WECHAT_ALLOW_SEND=false
# 主动发言：默认关闭；正常聊天中也会随机获得接话机会，模型仍可选择不回复。
WECHAT_PROACTIVE_REPLY=false
WECHAT_PROACTIVE_MIN_INTERVAL_SECONDS=300
WECHAT_PROACTIVE_MAX_PER_HOUR=6
WECHAT_PROACTIVE_PROBABILITY=0.4
# 可与计划模式同时开启；共用冷却、安静时段和主动额度，小时上限取已开启模式的较小值。
# 受邀的 @ / 点名 / 关键词回复不计入主动额度；对其他人的 @ 不随机抢答。
PROACTIVE_SCHEDULE_ENABLED=false
PROACTIVE_WINDOW_MIN_MINUTES=60
PROACTIVE_WINDOW_MAX_MINUTES=120
PROACTIVE_QUIET_HOURS=23:00-09:00
PROACTIVE_SCORE_TIMEOUT_SECONDS=10
# 持续观察到冷场后，允许在参与窗口内偶尔自己开话题；不是每 30 分钟固定发送。
PROACTIVE_IDLE_ENABLED=true
PROACTIVE_IDLE_AFTER_MINUTES=30
PROACTIVE_IDLE_PROBABILITY=0.4
PROACTIVE_IDLE_MAX_PER_DAY=2
# 主动插话和关键词命中只是猜测：回复前先让模型判断这条消息到底在跟谁说话。
# 判定为“在回其他真人”时不回复；判定不确定时只作为旁观者接话，不认领成对自己的指责。
ADDRESSEE_GATE_ENABLED=true
ADDRESSEE_JUDGE_TIMEOUT_SECONDS=8
# 同一个人连续发几条短消息时，主动插话会把相邻几条合并成一次发言再回复，
# 避免只回应最后半句（例如「奖励是可以追zls」+「还有俩包苹果干」只接苹果干）。
PROACTIVE_BLOCK_ENABLED=true
PROACTIVE_BLOCK_GAP_SECONDS=60
PROACTIVE_BLOCK_MAX_MESSAGES=3
# auto：配置阿里云后优先识别，失败或无法理解则用微信转文字；wechat：无需 ASR 模型。
# local 仅为可选方式，需要额外安装 pip install -e '.[local-asr]'。
VOICE_ENABLED=true
VOICE_PROVIDER=auto
# wechat 模式下微信没返回转写时，用阿里云 ASR 兜底识别已保存的音频；none 维持仅微信。
VOICE_FALLBACK_PROVIDER=aliyun
ALIYUN_AUDIO_BASE_URL=
ALIYUN_AUDIO_API_KEY=
# 只用于生图和语音请求及素材下载；VM 可填写宿主机 HTTP 代理，LLM 和记忆连接不受影响。
MEDIA_HTTP_PROXY_URL=
ASR_MODEL=qwen-audio-3.1-asr-flash
WECHAT_VOICE_CONVERSION_TIMEOUT_SECONDS=25
VOICE_REPLY_ENABLED=true
SINGING_REPLY_ENABLED=true
# 普通回复先抽取语音；明确要求听声音时绕过随机概率，仍受上面的启用开关控制。
VOICE_REPLY_PROBABILITY=0.15
# 每条语音按句子情绪自动选语气并微调语速（平静/开心/撒娇/傲娇/委屈/生气/吐槽）；
# 关闭后只用 TTS_RATE 与 TTS_INSTRUCTION 的固定风格。
VOICE_STYLE_AUTO=true
# 语音合成供应商：aliyun | openai_compatible | elevenlabs | fish。
# 通用地址和 Key 优先于阿里云专用字段；openai_compatible 填 /v1 根地址，
# elevenlabs 可留空使用官方地址，fish 留空使用 https://api.fish.audio。
# fish 需要 TTS_MODEL=s2.1-pro、TTS_VOICE=社区音色 reference_id；非阿里云供应商通常只支持预置音色。
TTS_PROVIDER=aliyun
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=qwen-audio-3.1-tts-plus
TTS_VOICE=longanhuan_v3.1
TTS_INSTRUCTION=用轻快、自然的年轻女声说话，像和朋友聊天，情绪跟随句子的意思。
TTS_RATE=1.0
TTS_PITCH=1.0
TTS_LANGUAGE=auto
TTS_SEED=0
VOICE_REPLY_CACHE_DIR=state/voice-replies
VOICE_MODEL=small
VOICE_LANGUAGE=zh
VOICE_TIMEOUT_SECONDS=120
VOICE_VALIDATION_TIMEOUT_SECONDS=10
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_BYTES=5000000
VOICE_CACHE_DIR=state/voice
VOICE_CLARIFICATION_MIN_INTERVAL_SECONDS=60
WECHAT_POLL_SECONDS=2
# 回复队列：忙不过来时消息按到达顺序排队，每轮只回一条；0 表示不限长度。
WECHAT_REPLY_QUEUE_MAX_SIZE=50
# 回复频率控制：0 表示不额外限制；只对已命中 @/关键词且实际成功发送的回复计数。
WECHAT_REPLY_COOLDOWN_SECONDS=0
WECHAT_MAX_REPLIES_PER_HOUR=0
WECHAT_STOP_FILE=state/STOP
WECHAT_PROCESSING_LEASE_SECONDS=300
# Do not answer messages that were already visible before this listener started.
WECHAT_SKIP_EXISTING_ON_START=true
# 最近群消息会作为临时上下文传给模型；只查询当前微信号和当前群。
WECHAT_CONTEXT_MESSAGES=12
WECHAT_CONTEXT_MAX_CHARS=6000
# 单条回复字符上限：微信客户端对单条消息有字符上限，超出会被截断或拒发。
# 回复在发送前按句末裁剪到这里（0 表示不裁剪）。
WECHAT_MAX_REPLY_CHARS=2000
# 回复上下文按“话题段”取：从触发消息往前找，隔了 CONTEXT_TOPIC_GAP_SECONDS 就算换话题；
# 超过 CONTEXT_TOPIC_MAX_MINUTES 或 CONTEXT_TOPIC_MAX_MESSAGES 时保留开头与最近几句，
# 中间和更早的部分只做标记，不再把十几分钟前的旧话题混进来。
CONTEXT_TOPIC_ENABLED=true
CONTEXT_TOPIC_GAP_SECONDS=300
CONTEXT_TOPIC_MAX_MINUTES=30
CONTEXT_TOPIC_MAX_MESSAGES=12
CONTEXT_TOPIC_HEAD_MESSAGES=3
CONTEXT_TOPIC_SCAN_MESSAGES=40
CONTEXT_TOPIC_SCAN_CHARS=12000
# 单条消息进入提示词的字数上限；超出会标注“共 X 字”，避免模型读半句话当完整。
CONTEXT_MESSAGE_MAX_CHARS=1200
# 读取微信数据库中的图片附件并交给支持视觉输入的模型。
WECHAT_IMAGE_RECOGNITION_ENABLED=true
WECHAT_IMAGE_MAX_COUNT=4
WECHAT_IMAGE_MAX_BYTES=12000000
# 图片只在接下来的几条消息里参与回答；更早的图要等群友重新提到才会再带上。
WECHAT_IMAGE_CONTEXT_TURNS=4
WECHAT_IMAGE_REFERENCE_WINDOW=30
# 以下三个目录和 DATABASE_URL 可以整体指到其他磁盘，例如
#   WECHAT_MEDIA_DIR=D:/wechat-agent-data/wechat-media
#   IMAGE_OUTPUT_DIR=D:/wechat-agent-data/generated
#   DATABASE_URL=sqlite:///D:/wechat-agent-data/memory.db
WECHAT_MEDIA_DIR=state/wechat-media
IMAGE_OUTPUT_DIR=state/generated
EMBED_BASE=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
EMBED_MODEL=doubao-embedding-vision-251215
EMBED_KEY=
# 0 accepts the provider dimension; the configured model currently returns 2048.
EMBED_DIMENSION=0
EMBED_TIMEOUT_SECONDS=45
# 群聊风格拟合：只保存按账号+群聚合的统计画像，不保存群聊原文。
GROUP_STYLE_ENABLED=true
GROUP_STYLE_MIN_MESSAGES=20
GROUP_STYLE_REFRESH_MESSAGES=20
# 事件指纹保留上限，用于防止重放计数；不会保存对应消息正文。
GROUP_STYLE_SAMPLE_MESSAGES=80
GROUP_STYLE_MAX_CHARS=1800
# 画像只用最近 N 条消息重建，避免永久累加导致风格漂移。
GROUP_STYLE_WINDOW_MESSAGES=300
# 注入 prompt 的画像摘要上限（完整审计画像仍留在 SQL/OpenViking）。
PROFILE_PROMPT_MAX_CHARS=4000
# 用 LLM 从最近群聊合成 culture/jokes/nicknames/rules 等语义画像。
PROFILE_SYNTHESIS_ENABLED=true
PROFILE_SYNTHESIS_MESSAGES=120
PROFILE_SYNTHESIS_MAX_INPUT_CHARS=6000

# Local desktop control console. Use a token before binding beyond localhost.
DESKTOP_HOST=127.0.0.1
DESKTOP_PORT=8765
DESKTOP_TOKEN=

# 抖音 / 小红书可见浏览器连接器（默认关闭；开启后分别保存独立登录态）
PLATFORM_BROWSER_ENABLED=false
PLATFORM_BROWSER_DATA_DIR=browser-data
# 留空自动寻找 Chrome / Edge；也可以填写 chrome.exe 的绝对路径
PLATFORM_BROWSER_EXECUTABLE=
PLATFORM_BROWSER_HEADLESS=false
DOUYIN_ACCOUNT_ID=unbound
XIAOHONGSHU_ACCOUNT_ID=unbound
PLATFORM_BROWSER_SCROLL_STEPS=5
PLATFORM_BROWSER_PAGE_TIMEOUT_MS=20000
# 评论/回复仍需人工确认；默认不执行真实外发
PLATFORM_WRITE_ENABLED=false
PLATFORM_ACTION_DELAY_SECONDS=30
PLATFORM_MAX_ACTIONS_PER_HOUR=5
# @ 白名单：只填平台稳定用户 ID（不是昵称），多个用逗号分隔；
# 控制台「平台」页绑定的平台账号会自动进入对应白名单，通常留空即可。
DOUYIN_MENTION_ALLOWLIST=
XIAOHONGSHU_MENTION_ALLOWLIST=

# 三号互联：微信群里出现“想去/攻略/推荐”等意图时补平台搜索，
# 回复发送后可为已关联成员生成平台评论/@ 计划（默认 dry-run）。
PLATFORM_INTENT_ENABLED=true
PLATFORM_AUTO_COMMENT_AFTER_REPLY=false
PLATFORM_COMMENT_MAX_CHARS=200
PLATFORM_MEMORY_ENABLED=true
# 主动浏览默认关闭；打开后按间隔挑关键词浏览，默认只生成 dry-run 计划。
PLATFORM_PROACTIVE_ENABLED=false
PLATFORM_PROACTIVE_INTERVAL_MINUTES=240
PLATFORM_PROACTIVE_KEYWORDS=
PLATFORM_QUIET_HOURS=23:00-08:00

# 抖音私信 → 微信媒体桥（默认关闭；先开启 PLATFORM_BROWSER_ENABLED 并在
# 可见浏览器里扫码登录抖音）。只监听一个明确配置的会话；投递仍走微信发送
# 台账和数据库回读。
DOUYIN_BRIDGE_ENABLED=false
# 与普通私聊回复隔离开：私聊只做表情包互转时，关闭 WECHAT_PRIVATE_REPLY_ENABLED，
# 打开下面两个开关；群聊不参与跨软件表情互转。
DOUYIN_BRIDGE_WECHAT_ENABLED=true
DOUYIN_BRIDGE_WECHAT_AUTO_STICKER=true
# 目标私信会话的显示名（或控制台显示的 conversation_id）
DOUYIN_BRIDGE_CONVERSATION=
# 本地审计用的抖音账号标识，不是密码
DOUYIN_BRIDGE_ACCOUNT_ID=
# 先只准备文件、不点微信发送；确认链路后再改为 false
DOUYIN_BRIDGE_DRY_RUN=true
DOUYIN_BRIDGE_REPLY_ENABLED=true
# 非指令的普通聊天是否让模型接话（默认只处理“转到微信”一类明确指令）
DOUYIN_BRIDGE_CHAT_ENABLED=false
DOUYIN_BRIDGE_POLL_SECONDS=6
# “先发表情包/视频，再说转到微信”的有效上下文时间
DOUYIN_BRIDGE_CONTEXT_SECONDS=300
DOUYIN_BRIDGE_MAX_JOBS_PER_HOUR=60
DOUYIN_BRIDGE_MAX_VIDEO_MB=500
DOUYIN_BRIDGE_MAX_STICKER_MB=10
DOUYIN_BRIDGE_MAX_ALBUM_IMAGES=9
DOUYIN_BRIDGE_MEDIA_DIR=state/douyin-bridge
DOUYIN_BRIDGE_MEDIA_RETENTION_HOURS=2
DOUYIN_BRIDGE_CHAT_URL=https://www.douyin.com/chat
# 转发卡片在 DOM 里没有 aweme id 时，是否允许点开卡片反查（默认关闭）
DOUYIN_BRIDGE_CARD_CLICK_RESOLVE=false
DOUYIN_BRIDGE_QUIET_HOURS=23:00-08:00
# 页面卡死自愈：无头聊天页跑久了可能「列表正常、点开会话不切换」，只会刷
# CHAT_IDENTITY_UNCONFIRMED 且不再转发。连续多轮全部身份失败时按
# 重载 /chat → 重启无头浏览器（同一 profile，不重新扫码）→ 重启控制台的顺序恢复；
# 出现验证码/未登录只报警，等待人工处理。
DOUYIN_BRIDGE_WATCHDOG_ENABLED=true
DOUYIN_BRIDGE_WATCHDOG_IDENTITY_THRESHOLD=3
DOUYIN_BRIDGE_WATCHDOG_CONSOLE_RESTART=true
# 两次自动重启控制台的最小间隔（秒），24 小时内最多 5 次
DOUYIN_BRIDGE_WATCHDOG_CONSOLE_COOLDOWN_SECONDS=1800
# 无水印解析：自建 Douyin_TikTok_Download_API (DTK)；留空则视频链路不可用。
DTK_BASE_URL=
DTK_API_KEY=
DTK_TIMEOUT_SECONDS=30
DTK_PARSE_WAIT_SECONDS=20

# 联网研究（搜索和网页正文抓取分别控制）
# deepseek-search-api 使用 DSH 同款局域网中转；也可填 brave / tavily / searxng / none
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=deepseek-search-api
WEB_SEARCH_API_KEY=lan
WEB_SEARCH_BASE_URL=http://203.0.113.10:8787/v1/tools
WEB_SEARCH_MAX_RESULTS=5
# 开启后，消息中的 http(s) URL 会直接走本地 HTTP 抓取；空白域名列表表示允许所有公开网站。
WEB_FETCH_ENABLED=false
WEB_FETCH_ALLOWED_DOMAINS=
WEB_FETCH_MAX_CHARS=6000
WEB_TIMEOUT_SECONDS=15

# Use SQLite for the first local test. Set PostgreSQL before shared deployment.
# Windows 的绝对路径写成 sqlite:///D:/wechat-agent-data/memory.db 这种形式。
DATABASE_URL=sqlite:///state/memory.db
RAW_RETENTION_DAYS=90
CHAT_HALF_LIFE_DAYS=14
INTEREST_HALF_LIFE_DAYS=90
FACT_HALF_LIFE_DAYS=365

# 记忆：一条消息一次模型判定（事件＋长期事实＋一句话画像），没有关键词回退。
# 判定挂在后台线程，不增加回复延迟；超预算排队到次日，不丢消息。
MEMORY_EVENT_EXTRACTION_ENABLED=true
MEMORY_ORCHESTRATOR_ENABLED=true
MEMORY_CONTEXT_TOKEN_BUDGET=4000
MEMORY_JUDGE_MIN_CONFIDENCE=0.6
MEMORY_JUDGE_DAILY_BUDGET=3000
MEMORY_JUDGE_BATCH_SIZE=20
EMOTION_LAYER_ENABLED=true
SEMANTIC_GROUP_PROFILE_ENABLED=true

# 成员记忆 v2：每晚整理（合并重复/标记被取代的旧说法/生成当前画像总结）。
# 旧事实行不删除，只改状态并保留 valid_to；人工别名优先于自动推断。
MEMBER_RECONCILE_ENABLED=true
MEMBER_RECONCILE_MAX_MEMBERS=5
MEMBER_ALIAS_LEARNING_ENABLED=true
# 人工别名格式：成员=别名1|别名2;成员2=别名3。成员可填 wxid 或当前群昵称。
WECHAT_MEMBER_ALIASES=

# OpenAI-compatible endpoint. DeepSeek is the default provider when configured.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# 0 = omit max_tokens and let the model decide; a fixed small cap is consumed
# by a reasoning model's thinking tokens and can return an empty reply body.
LLM_MAX_OUTPUT_TOKENS=0
# 模型效果调节：温度越高越有变化；Top-P/重复惩罚为 1/0 时不额外发送对应参数。
LLM_TEMPERATURE=0.7
LLM_TOP_P=1
LLM_FREQUENCY_PENALTY=0
LLM_PRESENCE_PENALTY=0

# 人设：默认使用项目内置的大肥鱼；可改为任意 Markdown 文件，旁边的 references/ 会一并读取。
PERSONA_ENABLED=true
PERSONA_NAME=大肥鱼
PERSONA_FILE=personas/dafeiyu/SKILL.md
PERSONA_SOURCE_URL=https://github.com/ERUIHNIYHBKBNF/dafeiyu-persona
PERSONA_MAX_CHARS=12000
# 输出后处理：拦截自称 AI、吐泡泡和过激脏话；表情默认每条最多 1 个。
PERSONA_STYLE_FILTER=true
PERSONA_MAX_EMOJI=1

# 每晚本地导出当天群聊，供后续风格/行为数据整理；只导出，不自动训练权重。
TRAINING_EXPORT_ENABLED=false
TRAINING_EXPORT_DIR=data/training/daily
TRAINING_EXPORT_HOUR=23
TRAINING_EXPORT_MINUTE=30
TRAINING_EXPORT_CONTEXT_MESSAGES=6
TRAINING_EXPORT_ANONYMIZE=true

# 第二个模型：处理明确生图请求，以及聊天模型选择的可选鲸鱼娘配图。
# 接口：POST {IMAGE_MODEL_BASE_URL}/images/generations
IMAGE_MODEL_ENABLED=false
IMAGE_MODEL_BASE_URL=
IMAGE_MODEL_API_KEY=
IMAGE_MODEL=
# 主端点失败后再尝试的备用图片服务；三项需同时填写才会启用回退。
IMAGE_MODEL_FALLBACK_BASE_URL=
IMAGE_MODEL_FALLBACK_API_KEY=
IMAGE_MODEL_FALLBACK=
IMAGE_MODEL_SIZE=1024x1024
IMAGE_MODEL_RESPONSE_FORMAT=auto
IMAGE_MODEL_TIMEOUT_SECONDS=120
# 自动配图：先准备图片，再发文字和一张原生图片（两条消息），也允许只发图片。
# 每次只发一张单幅图；可以有通用短字，不放昵称和对象称呼。
# 未选中语音的回复再按此概率配图；内容由聊天模型规划，失败时保留文字兜底。
REACTION_IMAGES_ENABLED=true
REACTION_IMAGE_PROBABILITY=0.3
REACTION_IMAGE_CACHE_DIR=state/reaction-images

# 可选：把生图结果直接上传到阿里云 OSS，供其他客户端访问；微信连接器
# 始终优先发送本地原生图片附件，OSS 暂时不可用不会阻断微信发送。
IMAGE_UPLOAD_ENABLED=false
OSS_REGION=cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=m5-model
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=seedance-assets
# 私有 bucket 留空，程序会生成有效期为 7200 秒的 OSS 签名 URL。
OSS_SIGNED_URL_TTL_SECONDS=7200
# 公共 bucket 或 CDN 域名；填写后返回长期可访问的公开 URL。
OSS_PUBLIC_BASE_URL=
IMAGE_UPLOAD_TIMEOUT_SECONDS=120
IMAGE_UPLOAD_MAX_BYTES=20000000

# Account binding is intentionally explicit and local to the test group.
BINDING_CODE_TTL_MINUTES=10
DOUYIN_BRIDGE_LIST_SCAN=true
DOUYIN_BRIDGE_FULL_SCAN_SECONDS=600

# B 站 DASH 无水印导出（可选 SESSDATA 用于 1080P+）
BILIBILI_ENABLED=true
BILIBILI_SESSDATA=
BILIBILI_MAX_VIDEO_MB=500
FFMPEG_PATH=ffmpeg
