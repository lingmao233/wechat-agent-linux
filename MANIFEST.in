include README.md STATUS.md PRD.md requirements.txt
recursive-include docs *.md
recursive-include scripts *.py *.sh
recursive-include personas *.md
recursive-include migrations *.sql
recursive-include src/wechat_agent/web/templates *.html
recursive-include src/wechat_agent/web/static *.css *.js
recursive-include tests *.py
prune state
prune runtime
prune data
prune logs
prune .venv
prune .playwright-mcp
prune artifacts
global-exclude *.pyc __pycache__
exclude .env .env.*
include .env.linux.example
